APP_NAME=Feature Flag Platform API
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://feature_flags:feature_flags@localhost:5432/feature_flags
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_SAMESITE=lax
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=2097152
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
TRUST_PROXY_HEADERS=false
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SIGNUP_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
